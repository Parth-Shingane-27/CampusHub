{
  "name": "campushub",
  "version": "1.0.0",
  "description": "CampusHub - College Event Management Platform (Node.js, Express, MongoDB)",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "build": "npm --prefix client install && npm --prefix client run build",
    "client": "npm --prefix client run dev",
    "test": "node tests/mern_test_suite.js"
  },
  "keywords": [
    "campushub",
    "college-events",
    "express",
    "mongodb",
    "google-sign-in"
  ],
  "author": "Sakshi Shewale",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "google-auth-library": "^11.3.2",
    "mongoose": "^9.11.4"
  }
}
